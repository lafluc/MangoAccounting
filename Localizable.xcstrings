    "The database file could not be read. This is often temporary — a full disk, a file still in use, or missing permissions. Nothing has been changed on disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbankdatei konnte nicht gelesen werden. Das ist oft vorübergehend – volle Festplatte, Datei noch in Benutzung oder fehlende Rechte. Auf der Festplatte wurde nichts verändert."
          }
        },
        "frk": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Datnbankdatei hods ned lesn könna. Des is oft bloß vorübergehend – volle Plattn, Datei nu in Benutzung oder fehlende Rechte. Auf der Plattn is nix verändert wordn."
          }
        }
      }
    },
    "The database is available again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank ist wieder verfügbar."
          }
        },
        "frk": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Datnbank is widda do."
          }
        }
      }
    },
    "The database was created by a version of MangoAccounting that this version cannot read. Quitting and reopening sometimes clears this. Nothing has been changed on disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde mit einer Version von MangoAccounting erstellt, die diese Version nicht lesen kann. Ein Neustart hilft manchmal. Auf der Festplatte wurde nichts verändert."
          }
        },
        "frk": {
          "stringUnit": {
            "state": "translated",
